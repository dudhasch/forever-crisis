    "test": "node --test test/*.test.ts",
    "preview": "vite preview --port 5181"
  },
  "dependencies": {
    "fengari": "^0.1.5",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
